/ios
/android

# Book content stays local, never on GitHub (Oğuz, 2026-11-26)
/assets/books/*
!/assets/books/catalog.json
/assets/frases.json
/content-src/*.pdf
/src/content/registry.ts
# Arabic matching tables quote the book text as context
/scripts/arabic_overrides*.json
