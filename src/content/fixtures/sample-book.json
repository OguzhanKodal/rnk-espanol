          "spans": [
            { "t": "text", "text": "Una palabra de esperanza: " },
            { "t": "arabic", "text": "مِنْ حَيْثُ لَا يَحْتَسِبُ" },
            { "t": "text", "text": ". La " },
            { "t": "bold", "text": "gratitud" },
            { "t": "text", "text": " ilumina el camino de la " },
            { "t": "italic", "text": "fe" },
            { "t": "text", "text": "." }
          ]
        },
        {
          "id": "s1-b3",
          "type": "arabic",
          "text": "لَٓا اِلٰهَ اِلَّٓا اَنْتَ",
          "page": 1
        },
        {
          "id": "s1-b4",
          "type": "note",
          "page": 1,
          "spans": [{ "t": "text", "text": "[Esta es una nota de ejemplo.]" }]
        },
        { "id": "s1-b5", "type": "pageBreak", "page": 2 }
      ]
    },
